{
  "name": "sgai",
  "private": true,
  "type": "module",
  "scripts": {
    "demo:dj": "npm run demo:dj --prefix demo",
    "demo:llm": "tsx backend/scripts/demo-llm.ts",
    "demo:llm:comparar": "tsx backend/scripts/comparar-modelos.ts",
    "dev:api": "npm run dev --prefix backend",
    "dev:web": "npm run dev --prefix frontend",
    "dev:dj": "npm run dev:api & npm run dev:web",
    "test:domain:dj": "NODE_OPTIONS=--experimental-vm-modules jest backend/domain/declaracion-jurada/services/DJStateMachine.test.ts --watchman=false",
    "test:domain:auth": "NODE_OPTIONS=--experimental-vm-modules jest backend/domain/administracion --watchman=false",
    "test:domain:tramites": "NODE_OPTIONS=--experimental-vm-modules jest backend/domain/tramites-dpa --watchman=false",
    "test:domain:agente-dj": "NODE_OPTIONS=--experimental-vm-modules jest backend/domain/agente-dj --watchman=false",
    "test:infra:mcp": "NODE_OPTIONS=--experimental-vm-modules jest backend/infrastructure/mcp --watchman=false",
    "test:domain": "NODE_OPTIONS=--experimental-vm-modules jest backend/domain --watchman=false --coverage",
    "test:e2e": "playwright test --project=chromium --reporter=html,list",
    "test:e2e:report": "playwright show-report",
    "test:evals": "NODE_OPTIONS=--experimental-vm-modules jest --config evals/jest.config.cjs",
    "eval": "tsx evals/evaluar.ts",
    "eval:gate": "tsx evals/evaluar.ts correr v2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
