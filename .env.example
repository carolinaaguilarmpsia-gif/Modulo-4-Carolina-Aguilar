# Variables del stack de producción (compose.yaml). Copia este archivo a ".env" y cambia los valores.
# Sin ".env", `docker compose up -d --wait` usa los valores por defecto de compose.yaml, que son solo para la demo local.

# Obligatorio cambiarlo fuera de la demo: firma los tokens de sesión. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Clave de la base de datos (usuario y base: sgai). La base no se publica fuera de la red del stack.
POSTGRES_PASSWORD=cambia-esta-clave

# true = crea los usuarios y declaraciones juradas de ejemplo (clave Demo1234!). En un despliegue real: false.
SGAI_SEED_DEMO=false

# Asistente con modelo de lenguaje (opcional). Con IA_HABILITADA=false responde solo por palabras clave.
IA_HABILITADA=false
GROQ_API_KEY=
